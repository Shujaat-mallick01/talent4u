# Talent4u — environment. Copy to .env and fill in.
# .env is gitignored; this file is the checked-in list of what is needed.

# ── Database (Supabase Postgres) ───────────────────────────────────────────
# Pooled connection (port 6543) for the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct session connection (port 5432) — the Prisma CLI only. Migrations
# cannot run through the pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Supabase Auth ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server only. Never expose this to the browser.
SUPABASE_SECRET_KEY="sb_secret_..."

# ── Site ───────────────────────────────────────────────────────────────────
# Used for canonicals, JSON-LD, OAuth callbacks and every link inside an email.
# Must be the real origin in production, or emails will link to localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Without RESEND_API_KEY: development logs each message to the console instead
# of sending; production reports a failure rather than dropping mail silently.
#
# Setup: create a key at resend.com, then verify the sending domain — an
# unverified domain means everything lands in spam or bounces.
RESEND_API_KEY=""
# Must be on a domain verified in Resend.
EMAIL_FROM="Talent4u <notifications@yourdomain.com>"

# ── Development helpers ────────────────────────────────────────────────────
# Password set on every seeded account by prisma/dev-auth-users.ts.
DEV_SEED_PASSWORD="Talent4u-dev-2026"
